lib.version: 5.3.3

-buildpath:  \
	org.apache.httpcomponents.core5:httpcore5;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;org.apache.httpcomponents.core5:httpcore5:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: org.apache.httpcomponents.core5
Bundle-Vendor: Apache

Export-Package: org.apache.hc.core5.*
