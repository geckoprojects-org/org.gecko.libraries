lib.version: 1.21.1

-buildpath:  \
	net.sourceforge.lept4j:lept4j;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;net.sourceforge.lept4j:lept4j:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR
Bundle-Vendor: 

Export-Package: net.sourceforge.lept4j.*
