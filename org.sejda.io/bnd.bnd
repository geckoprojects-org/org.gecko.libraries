lib.version: 4.0.0.M4

-buildpath:  \
	org.sejda:sejda-io;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;org.sejda:sejda-io:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR of sejda-io
Bundle-License: Apache 2.0

Export-Package: org.sejda.io.*
