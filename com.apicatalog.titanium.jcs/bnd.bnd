lib.version: 2.0.0

-buildpath:  \
	com.apicatalog:titanium-jcs;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;com.apicatalog:titanium-jcs:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}.SNAPSHOT
Bundle-Localization: bundle
Bundle-Name: OSGified version of titanium-jcs
Bundle-Vendor: 
Bundle-SymbolicName: com.apicatalog.titanium.jcs

Export-Package: com.apicatalog.jcs.*

-maven-dependencies: \
    com.apicatalog.titanium-rdf-api;\
	  groupId=com.apicatalog;\
      artifactId=titanium-rdf-api;\
      scope=compile