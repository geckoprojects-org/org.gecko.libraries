lib.version: 3.0.0.M2

-buildpath:  \
	io.apicurio:apicurio-registry-client;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;io.apicurio:apicurio-registry-client:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR
Bundle-Vendor: Apicurio

Export-Package: io.apicurio.registry.rest.client.*
