-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-17
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

-runbundles: \
	com.google.errorprone.annotations;version='[2.50.0,2.50.1)',\
	com.google.gson;version='[2.14.0,2.14.1)',\
	com.google.guava;version='[33.6.0,33.6.1)',\
	com.google.guava.failureaccess;version='[1.0.3,1.0.4)',\
	com.google.protobuf;version='[4.35.1,4.35.2)',\
	io.grpc.core;version=snapshot,\
	io.grpc.netty;version=snapshot,\
	io.netty.buffer;version='[4.1.133,4.1.134)',\
	io.netty.codec;version='[4.1.133,4.1.134)',\
	io.netty.codec-http;version='[4.1.133,4.1.134)',\
	io.netty.codec-http2;version='[4.1.133,4.1.134)',\
	io.netty.codec-socks;version='[4.1.133,4.1.134)',\
	io.netty.common;version='[4.1.133,4.1.134)',\
	io.netty.handler;version='[4.1.133,4.1.134)',\
	io.netty.handler-proxy;version='[4.1.133,4.1.134)',\
	io.netty.resolver;version='[4.1.133,4.1.134)',\
	io.netty.transport;version='[4.1.133,4.1.134)',\
	io.netty.transport-native-unix-common;version='[4.1.133,4.1.134)',\
	org.jsr-305;version='[3.0.2,3.0.3)'

-runrequires: \
	bnd.identity;id='io.grpc.core',\
	bnd.identity;id='io.grpc.netty'
