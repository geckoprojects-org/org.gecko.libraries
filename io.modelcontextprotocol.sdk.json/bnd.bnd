lib.version: 0.14.1

-buildpath:  \
	io.modelcontextprotocol.sdk:mcp-json;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;io.modelcontextprotocol.sdk:mcp-json:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR for mcp-json 
Bundle-Vendor: Anthropic

Export-Package: io.modelcontextprotocol.json.*
