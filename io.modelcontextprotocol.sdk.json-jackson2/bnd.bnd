lib.version: 0.17.2

-buildpath:  \
	io.modelcontextprotocol.sdk:mcp-json-jackson2;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;io.modelcontextprotocol.sdk:mcp-json-jackson2:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR of io.modelcontextprotocol.sdk:mcp-json-jackson2
Bundle-Vendor: Anthropic

Export-Package: io.modelcontextprotocol.json.*
