lib.version: 6.1.0

-buildpath:  \
	org.apache.jena:jena-rdfconnection;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;org.apache.jena:jena-rdfconnection:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}.SNAPSHOT
Bundle-Localization: bundle
Bundle-Name: Apache Jena RDF Connection Re-packaged JAR
Bundle-Vendor: Apache Foundation, Data In Motion Consulting GmbH

Export-Package: \
	org.apache.jena.*,\