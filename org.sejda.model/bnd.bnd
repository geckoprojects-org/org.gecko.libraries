lib.version: 5.1.17

-buildpath: org.sejda:sejda-model;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;org.sejda:sejda-model:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}
Bundle-Localization: bundle
Bundle-Name: Re-packaged JAR of sejda-model
Bundle-License: AGPL 3.0

Export-Package: org.sejda.model.*
