lib.version: 0.14.0

-buildpath:  \
	com.apicatalog:tree-io-api;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;com.apicatalog:tree-io-api:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}.SNAPSHOT
Bundle-Localization: bundle
Bundle-Name: OSGified version of tree-io-api

Export-Package: \
	com.apicatalog.tree.*

-maven-dependencies: \
	com.apicatalog.titanium-jcs;\
	  groupId=com.apicatalog;\
      artifactId=titanium-jcs;\
      scope=compile,\
	com.apicatalog.tree-io-api;\
	  groupId=com.apicatalog;\
      artifactId=tree-io-api;\
      scope=compile,\
    com.apicatalog.titanium-rdf-api;\
	  groupId=com.apicatalog;\
      artifactId=titanium-rdf-api;\
      scope=compile,\
    com.apicatalog.titanium-rdf-n-quads;\
	  groupId=com.apicatalog;\
      artifactId=titanium-rdf-n-quads;\
      scope=compile