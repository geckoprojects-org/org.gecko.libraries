lib.version: 6.1.0

-buildpath:  \
	org.apache.jena:jena-langtag;version=${lib.version}
	
-includeresource: \
	OSGI-OPT/src=@${repo;org.apache.jena:jena-langtag:jar:sources;${lib.version};EXACT}

Bundle-Version: ${lib.version}.SNAPSHOT
Bundle-Name: Re-packaged Jena Langtag JAR
Bundle-Vendor: Apache Foundation, Data In Motion Consulting GmbH

Export-Package: org.apache.jena.*
